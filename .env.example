# Copy this file to .env and adjust as needed.
# DimScan reads these at startup; both are optional (segmentation/YOLOE has
# built-in defaults) and neither should ever contain secrets or credentials.

# Name of the YOLOE segmentation weights to load (see README for details).
DIMSCAN_YOLOE_MODEL_NAME=yoloe-11s-seg.pt

# Absolute path to a local YOLOE weights file, if you want to override the
# model name lookup above.
# DIMSCAN_YOLOE_MODEL_PATH=/path/to/yoloe-11s-seg.pt
